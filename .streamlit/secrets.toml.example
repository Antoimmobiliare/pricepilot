# PricePilot Streamlit Cloud secrets template.
# Paste these keys in Streamlit Cloud -> App -> Settings -> Secrets.
# Do not create or commit .streamlit/secrets.toml with real values.

PRICEPILOT_ENV = "production"
PRICEPILOT_DATA_PROVIDER = "demo"
# Owner workflow for Luma Pisa. It hides commercial plans and always proposes
# changes for explicit approval; it never enables a channel write by itself.
PRICEPILOT_OPERATIONAL_MODE = "1"
PRICEPILOT_ALLOW_CHANNEL_WRITES = "0"
PRICEPILOT_PRICING_BASIS = "calendar_only"
PRICEPILOT_CHANNEL_PROVIDER = "beds24"
PRICEPILOT_OCCUPANCY_PROVIDER = "observed_inventory"

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY = ""

APP_BASE_URL = "https://your-app.streamlit.app"
SUPABASE_AUTH_REDIRECT_URL = "https://your-app.streamlit.app"
SUPABASE_PASSWORD_RESET_REDIRECT_URL = "https://your-app.streamlit.app"

PRICEPILOT_API_BASE_URL = ""
PRICEPILOT_CORS_ORIGINS = "https://your-app.streamlit.app"
PRICEPILOT_DEFAULT_ACCOUNT_ID = "1"
PRICEPILOT_API_AUTH_REQUIRED = "1"
PRICEPILOT_API_KEY = ""
PRICEPILOT_API_KEYS_JSON = ""

TELEGRAM_BOT_TOKEN = ""
TELEGRAM_BOT_USERNAME = ""
TELEGRAM_WEBHOOK_SECRET = ""
PRICEPILOT_REQUIRE_TELEGRAM_WEBHOOK_SECRET = "0"
PRICEPILOT_AUTO_REGISTER_TELEGRAM_WEBHOOK = "0"

STRIPE_SECRET_KEY = ""
STRIPE_PRICE_PLUS = ""
STRIPE_PRICE_PRO = ""
STRIPE_SUCCESS_URL = "https://your-app.streamlit.app?billing=success"
STRIPE_CANCEL_URL = "https://your-app.streamlit.app?billing=cancel"
STRIPE_PORTAL_RETURN_URL = "https://your-app.streamlit.app"
STRIPE_WEBHOOK_SECRET = ""

SMOOBU_API_CONSUMER_KEY = ""
SMOOBU_API_CONSUMER_SECRET = ""
SMOOBU_APARTMENT_ID = ""
SMOOBU_API_BASE = "https://login.smoobu.com"
SMOOBU_LEGACY_API_KEY = ""
SMOOBU_API_TOKEN = ""

PRICEPILOT_ALLOW_LOCAL_AUTH = "0"
PRICEPILOT_ALLOW_PAID_SIGNUP_WITHOUT_CHECKOUT = "0"
PRICEPILOT_ALLOW_MANUAL_CYCLE = "0"
PRICEPILOT_AUTH_MODE = "local"

PRICEPILOT_SUPABASE_ACCOUNTS_TABLE = "accounts"
PRICEPILOT_SUPABASE_ACCOUNT_MEMBERS_TABLE = "account_members"
PRICEPILOT_SUPABASE_PROFILES_TABLE = "profiles"
PRICEPILOT_SUPABASE_PROPERTIES_TABLE = "properties"
PRICEPILOT_SUPABASE_PRICING_RULES_TABLE = "pricing_rules"
PRICEPILOT_SUPABASE_USER_CONSENTS_TABLE = "user_consents"
