# PricePilot environment template.
# Copy this file to .env for local development.
# Never commit the real .env file.

# Runtime mode: development, staging, production.
PRICEPILOT_ENV=development

# Database operativo. Mantieni sqlite per sviluppo/test locale. Imposta
# supabase solo dopo avere eseguito supabase/cloud_primary_cutover.sql e
# migrato i dati locali dell'account con pricepilot.services.supabase_migration.
PRICEPILOT_DATABASE_BACKEND=sqlite

# Data providers.
# Il percorso operativo usa il calendario dell'alloggio e l'approvazione umana.
# Impostare demo solo per esplorare le vecchie schermate con dati sintetici.
PRICEPILOT_DATA_PROVIDER=unconfigured
PRICEPILOT_PRICING_BASIS=calendar_only
PRICEPILOT_OCCUPANCY_PROVIDER=observed_inventory
PRICEPILOT_CHANNEL_PROVIDER=beds24
PRICEPILOT_HORIZON_DAYS=90
PRICEPILOT_ALLOW_CHANNEL_WRITES=0
# Optional overrides: demo, manual, unconfigured. Leave MARKET_PROVIDER empty
# in staging/production until a channel manager or licensed source is connected.
PRICEPILOT_MARKET_PROVIDER=
# Event signals are automatic and free: Italian national holidays work offline.
# Add a free Ticketmaster Discovery key for nearby concerts, fairs and sport.
PRICEPILOT_EVENT_PROVIDER=free
TICKETMASTER_API_KEY=
PRICEPILOT_EVENTS_COUNTRY_CODE=IT
PRICEPILOT_EVENTS_RADIUS_KM=40
PRICEPILOT_MANUAL_MARKET_CSV=data/manual_market.csv
PRICEPILOT_MANUAL_EVENTS_CSV=data/manual_events.csv
PRICEPILOT_MANUAL_OCCUPANCY_CSV=data/manual_occupancy.csv
PRICEPILOT_MANUAL_DEFAULT_OCCUPANCY=0.55

# Beds24: salvare nell'app solo questi nomi di variabile, mai i token.
BEDS24_LUMA_TOKEN=
BEDS24_LUMA_REFRESH_TOKEN=

# Supabase Auth + database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Optional, server-side only. Needed for trusted background sync/migrations
# when no interactive Supabase user session is available.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL where Supabase should send email confirmations and auth callbacks.
SUPABASE_AUTH_REDIRECT_URL=http://localhost:8501
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:8501

# Public app/API URLs.
APP_BASE_URL=http://localhost:8501
PRICEPILOT_API_BASE_URL=http://localhost:8000
PRICEPILOT_CORS_ORIGINS=http://localhost:8501

# API tenant/auth guard.
# In production configure API keys per account.
PRICEPILOT_DEFAULT_ACCOUNT_ID=1
PRICEPILOT_API_AUTH_REQUIRED=0
PRICEPILOT_API_KEY=
PRICEPILOT_API_KEYS_JSON=
# Segreto separato usato soltanto dal workflow GitHub ogni sei ore.
PRICEPILOT_SCHEDULER_KEY=

# Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PRICEPILOT_REQUIRE_TELEGRAM_WEBHOOK_SECRET=0
PRICEPILOT_AUTO_REGISTER_TELEGRAM_WEBHOOK=0

# Stripe billing.
# Free is activated without checkout. Plus/Pro require these price IDs.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:8501?billing=success
STRIPE_CANCEL_URL=http://localhost:8501?billing=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:8501
STRIPE_WEBHOOK_SECRET=

# Smoobu channel manager integration.
# Recommended HMAC credentials from Smoobu.
SMOOBU_API_CONSUMER_KEY=
SMOOBU_API_CONSUMER_SECRET=
# Must match the PricePilot property listing_id for live price sync.
SMOOBU_APARTMENT_ID=
SMOOBU_API_BASE=https://login.smoobu.com

# Legacy Smoobu auth, only if your Smoobu account still uses the old Api-Key flow.
SMOOBU_LEGACY_API_KEY=
SMOOBU_API_TOKEN=

# Optional OTA placeholders for future adapters.
AIRBNB_API_TOKEN=
AIRBNB_LISTING_ID=
BOOKING_API_KEY=
BOOKING_HOTEL_ID=
BOOKING_ROOM_ID=
VRBO_API_KEY=

# Temporary internal testing only. Keep disabled in production.
PRICEPILOT_ALLOW_LOCAL_AUTH=0
PRICEPILOT_ALLOW_PAID_SIGNUP_WITHOUT_CHECKOUT=0
PRICEPILOT_ALLOW_MANUAL_CYCLE=0
PRICEPILOT_AUTH_MODE=local

# Optional: use custom table names if you do not use supabase/schema.sql defaults.
PRICEPILOT_SUPABASE_ACCOUNTS_TABLE=accounts
PRICEPILOT_SUPABASE_ACCOUNT_MEMBERS_TABLE=account_members
PRICEPILOT_SUPABASE_PROFILES_TABLE=profiles
PRICEPILOT_SUPABASE_PROPERTIES_TABLE=properties
PRICEPILOT_SUPABASE_PRICING_RULES_TABLE=pricing_rules
PRICEPILOT_SUPABASE_USER_CONSENTS_TABLE=user_consents
